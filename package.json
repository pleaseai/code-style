{
  "name": "@pleaseai/code-style-monorepo",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "code-style for PleaseAI",
  "repository": {
    "type": "git",
    "url": "https://github.com/pleaseai/code-style.git"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.14"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "docs"
    ]
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "test": "turbo run test --filter=./packages/*",
    "release": "turbo run build",
    "docs:dev": "cd docs && bun run dev",
    "docs:build": "cd docs && bun run build",
    "docs:deploy": "cd docs && bun run deploy",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@pleaseai/eslint-config": "workspace:*",
    "eslint": "^10.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.0.0",
    "typescript": "^6.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,mdx,mjs,yml,yaml,css}": [
      "eslint --cache --fix"
    ]
  }
}
