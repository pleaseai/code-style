{
  "name": "@pleaseai/eslint-config",
  "type": "module",
  "version": "0.1.3",
  "description": "ESLint config for PleaseAI projects",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pleaseai/code-style.git",
    "directory": "packages/eslint-config"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package-json": {
      "types": "./dist/package-json.d.mts",
      "import": "./dist/package-json.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "bun test"
  },
  "peerDependencies": {
    "eslint": "^10.4.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-slop": ">=0.1.1",
    "eslint-plugin-sonarjs": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-import": {
      "optional": true
    },
    "eslint-plugin-slop": {
      "optional": true
    },
    "eslint-plugin-sonarjs": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@oxlint/plugins": "1.94.0",
    "eslint-formatting-reporter": "^0.0.0",
    "eslint-plugin-package-json": "^1.10.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^25.9.9",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
