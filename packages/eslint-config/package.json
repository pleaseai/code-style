{
  "name": "@pleaseai/eslint-config",
  "type": "module",
  "version": "0.1.0",
  "description": "ESLint config for PleaseAI projects",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pleaseai/code-style.git",
    "directory": "packages/eslint-config"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
