{
  "name": "@pleaseai/eslint-config",
  "type": "module",
  "version": "0.0.3",
  "description": "ESLint config for PleaseAI projects",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package-json": {
      "types": "./dist/package-json.d.mts",
      "import": "./dist/package-json.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "eslint": "^9.10.0 || ^10.0.0"
  },
  "dependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "eslint-plugin-package-json": "^0.91.0"
  },
  "devDependencies": {
    "eslint": "^10.0.3",
    "tsdown": "^0.21.5",
    "typescript": "^6.0.2"
  }
}
