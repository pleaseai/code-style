      "types": "./dist/package-json.d.mts",
      "import": "./dist/package-json.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "eslint": "^10.4.0"
  },
  "dependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "eslint-plugin-package-json": "^1.10.1"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
