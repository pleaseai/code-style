{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "40000",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bun install --ignore-scripts"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "vitest@pleaseai": true,
    "tsdown@pleaseai": true,
    "claude-md-management@pleaseai": true,
    "gatekeeper@pleaseai": true,
    "fetch@pleaseai": true,
    "markitdown@pleaseai": true,
    "code-intelligence-lsp@code-intelligence": true,
    "ast-grep@pleaseai": true,
    "modern-web-guidance@pleaseai": true,
    "turborepo@pleaseai": true,
    "antfu@pleaseai": true
  },
  "extraKnownMarketplaces": {
    "pleaseai": {
      "source": {
        "source": "github",
        "repo": "pleaseai/claude-code-plugins"
      },
      "autoUpdate": true
    },
    "mastra-agent-skills": {
      "source": {
        "source": "github",
        "repo": "amondnet/mastra-agent-skills"
      },
      "autoUpdate": true
    },
    "code-intelligence": {
      "source": {
        "source": "github",
        "repo": "chatbot-pf/code-intelligence"
      },
      "autoUpdate": true
    }
  }
}
