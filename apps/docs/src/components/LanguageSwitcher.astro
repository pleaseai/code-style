---
/**
 * LanguageSwitcher — links the current page to its translations. Renders
 * nothing on pages without a counterpart in another locale (e.g. `/404`).
 *
 * Links force a full page load (`data-astro-reload`): Pagefind picks its
 * per-language index from `<html lang>` once per document, so a client-side
 * swap into another locale would keep searching the previous language.
 */
import Icon from '@cloudflare/nimbus-docs/components/Icon.astro'
import { stripBase, withBase } from '@cloudflare/nimbus-docs/runtime'
import { getLocaleAlternates } from '@/i18n/alternates'
import { getLocaleFromPath, localeLabels, ui } from '@/i18n/locales'

const pagePath = stripBase(Astro.url.pathname, import.meta.env.BASE_URL)
const alternates = await getLocaleAlternates(pagePath)
const { language } = ui[getLocaleFromPath(pagePath)]
---

{alternates.length > 1 && (
  <nav aria-label={language} data-nb-language-switcher class="flex items-center gap-1 text-[0.8125rem] font-medium">
    <Icon name="ph:translate" class="w-4 h-4 text-muted-foreground" aria-hidden="true" />
    {alternates.map(alternate => (
      <a
        href={withBase(alternate.path, import.meta.env.BASE_URL)}
        hreflang={alternate.locale}
        lang={alternate.locale}
        data-astro-reload
        aria-current={alternate.current ? 'page' : undefined}
        class:list={[
          'px-1.5 py-1 rounded-md no-underline transition-colors whitespace-nowrap',
          alternate.current
            ? 'text-foreground bg-accent'
            : 'text-muted-foreground hover:text-foreground hover:bg-accent/60',
        ]}
      >
        {localeLabels[alternate.locale]}
      </a>
    ))}
  </nav>
)}
